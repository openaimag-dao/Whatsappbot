# --- WhatsApp Cloud API (Meta for Developers -> ваше приложение -> WhatsApp -> API Setup) ---
# Постоянный токен доступа (System User token)
WHATSAPP_TOKEN=
# ID номера телефона (Phone number ID), НЕ сам номер
WHATSAPP_PHONE_NUMBER_ID=
# Любая строка, которую вы укажете в настройках вебхука как Verify token
WHATSAPP_VERIFY_TOKEN=my-secret-verify-token
# App Secret (App settings -> Basic) — для проверки подписи входящих запросов
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0

# --- Магазин ---
SHOP_NAME=Мой магазин
CURRENCY=₽
# Номер менеджера в международном формате без "+" (сюда приходят заказы и запросы)
MANAGER_PHONE=

# --- AI-консультант (необязательно). Без ключа бот работает только по меню ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

PORT=3000
