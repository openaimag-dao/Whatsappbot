# --- WhatsApp Cloud API (Meta for Developers -> ваше приложение -> WhatsApp -> API Setup) ---
# Постоянный токен доступа (System User token)
WHATSAPP_TOKEN=
# ID номера телефона (Phone number ID), НЕ сам номер
WHATSAPP_PHONE_NUMBER_ID=
# Любая строка, которую вы укажете в настройках вебхука как Verify token
WHATSAPP_VERIFY_TOKEN=my-secret-verify-token
# App Secret (App settings -> Basic) — для проверки подписи входящих запросов
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0

# --- Магазин ---
SHOP_NAME=AIMAG ELECTRIC
CURRENCY=₸
SHOP_PHONE=+7 705 615-17-17
SHOP_HOURS=Пн–Пт, 09:00–18:00
# Номер менеджера в международном формате без "+", например 77056151717 (сюда приходят заявки)
MANAGER_PHONE=

# --- AI-консультант (необязательно). Без ключа бот работает только по меню ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

PORT=3000

# --- Документы ---
# Путь к PNG печати с подписью (прозрачный фон), не хранить в репозитории
STAMP_PATH=templates/assets/stamp_sign.png

# --- Реквизиты (по умолчанию — ИП «AIMAG», см. src/config.js) ---
# COMPANY_KBE=19
COMPANY_EMAIL=

# --- Цены с ekt.kz (Электрокомплект). Без ключа Firecrawl поиск на ekt.kz выключен ---
FIRECRAWL_API_KEY=
# Цена клиенту = цена ekt.kz × (1 − 0.05)
EKT_UNDERCUT=0.05
# Скидка AIMAG у ekt.kz от цены сайта; по разделам: {"kabel_provod":0.2}
EKT_DISCOUNT=0.2
EKT_DISCOUNT_BY_CATEGORY={}
# Прибыль ниже этого порога → КП только после «ок <номер>» от менеджера
MIN_MARGIN=0.1
